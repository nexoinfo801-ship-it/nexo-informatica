<Window x:Class="Playloud.Cliente.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Playloud PDV &amp; ERP"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#070B12"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0D131D" />
        <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#121A26" />
        <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#162131" />
        <SolidColorBrush x:Key="BorderBrush" Color="#223044" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2F80ED" />
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#182E4E" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F7F9FC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A7B2C3" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#748196" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#4CC38A" />

        <Style x:Key="NavItem" TargetType="Border">
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="80" />
        </Style>
    </Window.Resources>

    <Grid Background="#070B12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#090E16"
                BorderBrush="#172231"
                BorderThickness="0,0,1,0">
            <Grid Margin="20,22,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Border Width="42"
                            Height="42"
                            HorizontalAlignment="Left"
                            Background="{StaticResource PrimaryBrush}"
                            CornerRadius="11">
                        <TextBlock Text="P"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="ProductTitle"
                               Text="Playloud PDV &amp; ERP"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,14,0,3" />
                    <TextBlock Text="Cliente • operação comercial"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" />
                </StackPanel>

                <StackPanel x:Name="NavigationRail" Grid.Row="2">
                    <TextBlock Text="OPERAÇÃO"
                               Style="{StaticResource SectionLabel}"
                               Margin="11,0,0,8" />

                    <Border Style="{StaticResource NavItem}"
                            Background="{StaticResource PrimarySoftBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BF;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="#79B4FF"
                                       FontSize="17"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="PDV"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource NavItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7B8;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="17"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Estoque"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource NavItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="17"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Clientes"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource NavItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8C7;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="17"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Financeiro"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource NavItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE9D2;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="17"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Relatórios"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <TextBlock Text="SISTEMA"
                               Style="{StaticResource SectionLabel}"
                               Margin="11,24,0,8" />

                    <Border Style="{StaticResource NavItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="17"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Configurações"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource NavItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE895;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="17"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Atualizações"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Grid.Row="3"
                        Background="#0E1723"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="26"
                                Height="26"
                                Background="#153626"
                                CornerRadius="13"
                                VerticalAlignment="Center">
                            <TextBlock Text="✓"
                                       Foreground="{StaticResource SuccessBrush}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Operação local"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Runtime conectado"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="30,22,30,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="OperationalHeader"
                    Grid.Row="0"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Ponto de Venda"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="25"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Venda rápida, operação local e dados protegidos."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12"
                                   Margin="0,5,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#0D1723"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,10"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{StaticResource SuccessBrush}"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="Sistema disponível"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="SalesWorkspace" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="26">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Venda atual"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="O fluxo de finalização já está conectado ao runtime real."
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#102036"
                                    CornerRadius="9"
                                    Padding="10,6"
                                    VerticalAlignment="Top">
                                <TextBlock Text="CAIXA PRINCIPAL"
                                           Foreground="#79B4FF"
                                           FontSize="10"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="#0A1019"
                                BorderBrush="#26364C"
                                BorderThickness="1"
                                CornerRadius="12"
                                Height="58">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="17"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Leitura e busca de produto"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="13" />
                                    <TextBlock Text="Interface preparada para código de barras, busca e atalhos."
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="F2"
                                           Foreground="#8EA3BC"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ITEM"
                                           Style="{StaticResource SectionLabel}" />
                                <TextBlock Grid.Column="1"
                                           Text="QTD."
                                           Style="{StaticResource SectionLabel}"
                                           HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2"
                                           Text="TOTAL"
                                           Style="{StaticResource SectionLabel}"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <Border Grid.Row="1"
                                    Margin="0,14,0,0"
                                    Background="#091019"
                                    BorderBrush="#1C293A"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="30">
                                    <Border Width="52"
                                            Height="52"
                                            Background="#112033"
                                            CornerRadius="14">
                                        <TextBlock Text="&#xE719;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="#6FAEFF"
                                                   FontSize="22"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Nenhum item na venda"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,14,0,0" />
                                    <TextBlock Text="A área de itens será ligada ao carrinho persistente no próximo ciclo."
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border x:Name="CheckoutStatusCard"
                            Background="{StaticResource SurfaceElevatedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="22">
                        <StackPanel>
                            <TextBlock Text="STATUS DA VENDA"
                                       Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0" />
                            <Border Height="1"
                                    Background="#26364A"
                                    Margin="0,20" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Último total"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding LastTotal, StringFormat={}{0:C2}, TargetNullValue=R$ 0,00}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#0C141F"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="22"
                            Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="AMBIENTE"
                                       Style="{StaticResource SectionLabel}" />
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Banco local"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" />
                                <TextBlock Grid.Column="1"
                                           Text="ATIVO"
                                           Foreground="{StaticResource SuccessBrush}"
                                           FontSize="10"
                                           FontWeight="Bold" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Modo de operação"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" />
                                <TextBlock Grid.Column="1"
                                           Text="LOCAL"
                                           Foreground="#79B4FF"
                                           FontSize="10"
                                           FontWeight="Bold" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
